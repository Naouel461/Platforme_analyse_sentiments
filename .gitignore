# ============================================================
# .gitignore — Projet SentimentFlow
# ============================================================

# ============================================================
# FICHIERS TEMPORAIRES ET BINAIRES
# ============================================================
*~
*.py[cod]
*.so
*.orig
*.log
*.pot
__pycache__/*
.cache/*
.*.swp
*/.ipynb_checkpoints/*
.DS_Store

# ============================================================
# FICHIERS DE PROJET
# ============================================================
.ropeproject
.project
.pydevproject
.settings
tags

# ============================================================
# PACKAGES PYTHON
# ============================================================
*.egg
*.eggs/
.installed.cfg
*.egg-info

# ============================================================
# TESTS ET COUVERTURE
# ============================================================
htmlcov/*
.coverage
.coverage.*
.tox
junit*.xml
coverage.xml
.pytest_cache/

# ============================================================
# BUILD ET DOCS
# ============================================================
build/*
dist/*
sdist/*
docs/api/*
docs/_rst/*
docs/_build/*
cover/*
MANIFEST

# ============================================================
# ENVIRONNEMENTS VIRTUELS
# ============================================================
.venv*/
.conda*/
.python-version

# ============================================================
# DVC — RÈGLES CRITIQUES
# ============================================================
# ⚠️ NE PAS ignorer les fichiers .dvc ! Ce sont les pointeurs DVC.
# DVC a besoin que Git suive les fichiers .dvc pour retrouver les données.
#
# Ce qu'on ignore : le contenu volumineux des données/modèles
# Ce qu'on garde : les fichiers .dvc et les .gitignore créés par DVC

# Dossier data : ignorer le contenu MAIS garder les .dvc
# Dossier data/ — géré par DVC (ne pas ignorer le dossier en entier)
# data/raw/ et data/processed/ sont gérés par DVC
# On ignore seulement le contenu, mais on garde :
#   - data/*.dvc (pointeurs DVC)
#   - data/.gitignore (créé par DVC)
data/raw/*
!data/raw.dvc
!data/.gitignore
data/processed/*
!data/processed/*.dvc

# Dossier models : ignorer le contenu MAIS garder les .dvc
/models
/models/**
!/models/**/
!/models/**/*.dvc
!/models/**/.gitignore

# Configuration locale DVC (peut contenir des secrets)
.dvc/config.local
.dvc/tmp/

# ============================================================
# EXÉCUTABLES ET OUTILS
# ============================================================
mc.exe

# ============================================================
# FICHIERS TEMPORAIRES
# ============================================================
*.tmp
*.bak
temp.json
test_*.py
simple_*.py
test_*.txt
/test.txt

# ============================================================
# VARIABLES D'ENVIRONNEMENT (SECRETS)
# ============================================================
.env
.env.local
.env.*.local

# ============================================================
# GESTIONNAIRES DE PAQUETS
# ============================================================
package-lock.json
package.json.bak

# ============================================================
# IDE
# ============================================================
.vscode/
.idea/
*.swp
*.swo
/mon_modele.pkl
